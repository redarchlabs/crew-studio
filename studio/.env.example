# Copy to studio/.env (never commit .env). Read by docker compose and the Go service.
STUDIO_DB_PASSWORD=change-me
STUDIO_DB_PORT=55432
STUDIO_DATABASE_URL=postgres://crewstudio:change-me@127.0.0.1:55432/crewstudio?sslmode=disable
# Separate database for the Go integration tests (created by `make test-db`)
STUDIO_TEST_DATABASE_URL=postgres://crewstudio:change-me@127.0.0.1:55432/crewstudio_test?sslmode=disable

# Go service
STUDIO_ADDR=127.0.0.1:8088
# Python with crewai installed, the runner script, and the .env holding OPENAI_API_KEY / GEMINI_API_KEY
STUDIO_PYTHON=../.venv/bin/python
STUDIO_RUNNER=runner/run_crew.py
STUDIO_PROVIDER_ENV_FILE=../.env
# Directory the file tools may read and write; each run gets its own folder inside it
STUDIO_WORKSPACE=workspace
# Private folder for run transcripts before they are uploaded (agents cannot reach it)
STUDIO_DATA_DIR=data
# Origins allowed to call the API from a browser (the Vite dev server)
STUDIO_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Serve the built UI from the Go service (optional)
STUDIO_WEB_DIR=web/dist

# Address people use. SSO redirect URLs are built from it: register
#   <STUDIO_PUBLIC_URL>/api/auth/microsoft/callback and <STUDIO_PUBLIC_URL>/api/auth/clerk/callback
# with the providers. Use https whenever Crew Studio is reachable from other machines.
STUDIO_PUBLIC_URL=http://localhost:8088
# Password sign-in for administrators (first-run setup and when SSO is down). Set false once SSO works.
STUDIO_LOCAL_LOGIN=true

# Microsoft Entra ID (single tenant): app registration > Overview gives the tenant and client ids;
# Certificates & secrets gives the secret. Leave all three empty to turn Microsoft sign-in off.
STUDIO_MICROSOFT_TENANT_ID=
STUDIO_MICROSOFT_CLIENT_ID=
STUDIO_MICROSOFT_CLIENT_SECRET=
# Clerk: Configure > OAuth applications. The issuer is your Frontend API URL (https://<name>.clerk.accounts.dev).
STUDIO_CLERK_ISSUER=
STUDIO_CLERK_CLIENT_ID=
STUDIO_CLERK_CLIENT_SECRET=

# File storage for work order attachments, files agents write and run transcripts: azure, gcs or none.
# Locally the docker-compose Azurite container stands in for Azure Blob Storage.
STUDIO_STORAGE=azure
STUDIO_AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STUDIO_AZURE_CONTAINER=crewstudio
# For Google Cloud Storage: the bucket must exist; credentials come from this file or Application Default Credentials
STUDIO_GCS_BUCKET=
STUDIO_GCS_CREDENTIALS_FILE=

# Help search ranks by meaning with embeddings, blended with keyword matching. "openai" uses text-embedding-3-small
# (OPENAI_API_KEY from the provider .env), "gemini" uses gemini-embedding-2 (GEMINI_API_KEY; the key must allow the
# embedContent methods), and "keyword" never calls an external service. Without the key it falls back to keywords.
STUDIO_HELP_SEARCH=openai
# Crew memory embeddings: openai, gemini or off. Unset follows STUDIO_HELP_SEARCH (off when that is keyword).
# STUDIO_MEMORY_EMBEDDINGS=openai

# Encrypts the secrets of connections to outside systems (Jira, Linear, KM2, Slack, ...), AES-256-GCM. 32 random
# bytes as base64: openssl rand -base64 32. Leave empty to keep connections off. Once connections exist the service
# will not start without the key they were saved with, so back it up with the database.
# To change the key: stop the service, run
#   STUDIO_SECRETS_KEY_OLD=<old> STUDIO_SECRETS_KEY_NEW=<new> crewstudio rotate-secrets-key
# (OLD defaults to STUDIO_SECRETS_KEY), which re-encrypts every secret in one transaction, then set the new key here.
STUDIO_SECRETS_KEY=
