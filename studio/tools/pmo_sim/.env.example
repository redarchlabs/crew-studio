# Copy to studio/tools/pmo_sim/.env (gitignored) and fill in. Environment variables override this file.

# Site root of the KM2 instance, no path (https required except for localhost).
KM2_BASE_URL=https://km2.example.com

# "Simulator" key minted in the PMO Sandbox org (Admin -> API): entities:read, records:read, records:write.
KM2_API_KEY=km2_replace_with_simulator_key

# "Bootstrap" key, only for bootstrap-schema: config:read + config:write, expires after 1 day. Revoke after use.
KM2_BOOTSTRAP_KEY=km2_replace_with_bootstrap_key

# Optional: seconds between requests (default 0.11, under KM2's 600 requests/min per key).
# PMO_SIM_MIN_INTERVAL=0.11
